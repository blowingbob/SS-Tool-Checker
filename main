    $scroll.Margin = "0,10,0,0"

    $stack = New-Object System.Windows.Controls.StackPanel
    $catTools = $ToolData | Where-Object { $_.Category -eq $cat }

    foreach ($tool in $catTools) {
        $t = $tool

        $btn = New-Object System.Windows.Controls.Button
        $btn.Height = 65
        $btn.Margin = "0,0,0,8"
        $btn.Cursor = "Hand"
        $btn.Foreground = $textBrush
        $btn.Background = [Windows.Media.BrushConverter]::new().ConvertFrom("#161B26")
        
        $accentColor = switch ($t.Type) {
            "GitHub" { "#3B82F6" }
            "Cmd"    { "#10B981" }
            "Web"    { "#F59E0B" }
            "Link"   { "#9CA3AF" }
            default  { "#8B5CF6" }
        }

        $btn.Template = [Windows.Markup.XamlReader]::Parse(
            "<ControlTemplate xmlns='http://schemas.microsoft.com/winfx/2006/xaml/presentation' TargetType='Button'>" +
            "  <Border CornerRadius='6' Background='{TemplateBinding Background}' BorderBrush='$accentColor' BorderThickness='4,0,0,0'>" +
            "    <ContentPresenter HorizontalAlignment='Stretch' VerticalAlignment='Center' Margin='15,0'/>" +
            "  </Border>" +
            "</ControlTemplate>"
        )

        $grid = New-Object System.Windows.Controls.Grid
        $grid.ColumnDefinitions.Add((New-Object System.Windows.Controls.ColumnDefinition)) | Out-Null
        $grid.ColumnDefinitions[0].Width = [System.Windows.GridLength]::new(1, [System.Windows.GridUnitType]::Star)
        $grid.ColumnDefinitions.Add((New-Object System.Windows.Controls.ColumnDefinition)) | Out-Null
        $grid.ColumnDefinitions[1].Width = [System.Windows.GridLength]::Auto

        $leftStack = New-Object System.Windows.Controls.StackPanel
        $nameBlock = New-Object System.Windows.Controls.TextBlock
        $nameBlock.Text = $t.Name
        $nameBlock.FontSize = 15
        $nameBlock.FontWeight = "Bold"
        $nameBlock.Foreground = [Windows.Media.Brushes]::White
        $descBlock = New-Object System.Windows.Controls.TextBlock
        $descBlock.Text = $t.Desc
        $descBlock.FontSize = 11
        $descBlock.Foreground = [Windows.Media.BrushConverter]::new().ConvertFrom("#9CA3AF")
        $descBlock.Margin = "0,2,0,0"
        $leftStack.Children.Add($nameBlock) | Out-Null
        $leftStack.Children.Add($descBlock) | Out-Null

        $srcBadge = New-Object System.Windows.Controls.Border
        $srcBadge.CornerRadius = 4
        $srcBadge.Padding = "8,4"
        $srcBadge.VerticalAlignment = "Center"
        $srcBadge.Background = [Windows.Media.BrushConverter]::new().ConvertFrom("#1F2937")
        
        $srcText = New-Object System.Windows.Controls.TextBlock
        $srcText.Text = $t.Type.ToUpper()
        $srcText.FontSize = 10
        $srcText.FontWeight = "Black"
        $srcText.Foreground = [Windows.Media.BrushConverter]::new().ConvertFrom($accentColor)
        $srcBadge.Child = $srcText

        $grid.Children.Add($leftStack) | Out-Null
        $grid.Children.Add($srcBadge) | Out-Null
        [System.Windows.Controls.Grid]::SetColumn($leftStack, 0)
        [System.Windows.Controls.Grid]::SetColumn($srcBadge, 1)

        $btn.Content = $grid

        $btn.Add_MouseEnter({ $_.Source.Background = [Windows.Media.BrushConverter]::new().ConvertFrom("#1F2937") })
        $btn.Add_MouseLeave({ $_.Source.Background = [Windows.Media.BrushConverter]::new().ConvertFrom("#161B26") })

        $btn.Add_Click({
            $clickedBtn = $_.Source
            $tName      = ($clickedBtn.Content.Children[0].Children[0]).Text
            $tData      = $ToolData | Where-Object { $_.Name -eq $tName } | Select-Object -First 1
            if ($tData) { Invoke-ToolAction -tool $tData }
        })

        $stack.Children.Add($btn) | Out-Null
    }

    $scroll.Content = $stack
    $tab.Content = $scroll
    $ToolsTab.Items.Add($tab) | Out-Null
}

# ==============================================================================
# SEARCH FUNCTIONALITY
# ==============================================================================
$searchPanel = New-Object System.Windows.Controls.ScrollViewer
$searchPanel.VerticalScrollBarVisibility = "Auto"
$searchPanel.Margin = "0,10,0,0"
$searchStack = New-Object System.Windows.Controls.StackPanel

$ToolsTab.Parent.Children.Add($searchPanel) | Out-Null
$searchPanel.Content = $searchStack
$searchPanel.Visibility = "Collapsed"

$SearchBox.Add_TextChanged({
    $query = $SearchBox.Text.Trim()
    if ($query.Length -eq 0) {
        $ToolsTab.Visibility = "Visible"
        $searchPanel.Visibility = "Collapsed"
        return
    }

    $ToolsTab.Visibility = "Collapsed"
    $searchPanel.Visibility = "Visible"

    $matches = $ToolData | Where-Object {
        $_.Name -like "*$query*" -or $_.Desc -like "*$query*" -or $_.Category -like "*$query*"
    }

    $searchStack.Children.Clear()
    
    if ($matches.Count -eq 0) {
        $noRes = New-Object System.Windows.Controls.TextBlock
        $noRes.Text = "Geen tools gevonden voor '$query'"
        $noRes.Foreground = [Windows.Media.BrushConverter]::new().ConvertFrom("#9CA3AF")
        $noRes.Margin = "10,20,0,0"
        $noRes.FontSize = 14
        $searchStack.Children.Add($noRes) | Out-Null
        return
    }

    foreach ($tool in $matches) {
        $btn = New-Object System.Windows.Controls.Button
        $btn.Height = 65
        $btn.Margin = "0,0,0,8"
        $btn.Cursor = "Hand"
        $btn.Background = [Windows.Media.BrushConverter]::new().ConvertFrom("#161B26")
        
        $accentColor = switch ($tool.Type) {
            "GitHub" { "#3B82F6" }
            "Cmd"    { "#10B981" }
            "Web"    { "#F59E0B" }
            "Link"   { "#9CA3AF" }
            default  { "#8B5CF6" }
        }

        $btn.Template = [Windows.Markup.XamlReader]::Parse(
            "<ControlTemplate xmlns='http://schemas.microsoft.com/winfx/2006/xaml/presentation' TargetType='Button'>" +
            "  <Border CornerRadius='6' Background='{TemplateBinding Background}' BorderBrush='$accentColor' BorderThickness='4,0,0,0'>" +
            "    <ContentPresenter HorizontalAlignment='Stretch' VerticalAlignment='Center' Margin='15,0'/>" +
            "  </Border>" +
            "</ControlTemplate>"
        )

        $grid = New-Object System.Windows.Controls.Grid
        $grid.ColumnDefinitions.Add((New-Object System.Windows.Controls.ColumnDefinition)) | Out-Null
        $grid.ColumnDefinitions[0].Width = [System.Windows.GridLength]::new(1, [System.Windows.GridUnitType]::Star)
        $grid.ColumnDefinitions.Add((New-Object System.Windows.Controls.ColumnDefinition)) | Out-Null
        $grid.ColumnDefinitions[1].Width = [System.Windows.GridLength]::Auto

        $leftStack = New-Object System.Windows.Controls.StackPanel
        $nameBlock = New-Object System.Windows.Controls.TextBlock
        $nameBlock.Text = $tool.Name
        $nameBlock.FontSize = 15
        $nameBlock.FontWeight = "Bold"
        $nameBlock.Foreground = [Windows.Media.Brushes]::White
        $descBlock = New-Object System.Windows.Controls.TextBlock
        $descBlock.Text = "$($tool.Desc)  -  $($tool.Category)"
        $descBlock.FontSize = 11
        $descBlock.Foreground = [Windows.Media.BrushConverter]::new().ConvertFrom("#9CA3AF")
        $descBlock.Margin = "0,2,0,0"
        $leftStack.Children.Add($nameBlock) | Out-Null
        $leftStack.Children.Add($descBlock) | Out-Null

        $srcBadge = New-Object System.Windows.Controls.Border
        $srcBadge.CornerRadius = 4
        $srcBadge.Padding = "8,4"
        $srcBadge.VerticalAlignment = "Center"
        $srcBadge.Background = [Windows.Media.BrushConverter]::new().ConvertFrom("#1F2937")
        
        $srcText = New-Object System.Windows.Controls.TextBlock
        $srcText.Text = $tool.Type.ToUpper()
        $srcText.FontSize = 10
        $srcText.FontWeight = "Black"
        $srcText.Foreground = [Windows.Media.BrushConverter]::new().ConvertFrom($accentColor)
        $srcBadge.Child = $srcText

        $grid.Children.Add($leftStack) | Out-Null
        $grid.Children.Add($srcBadge) | Out-Null
        [System.Windows.Controls.Grid]::SetColumn($leftStack, 0)
        [System.Windows.Controls.Grid]::SetColumn($srcBadge, 1)

        $btn.Content = $grid

        $btn.Add_MouseEnter({ $_.Source.Background = [Windows.Media.BrushConverter]::new().ConvertFrom("#1F2937") })
        $btn.Add_MouseLeave({ $_.Source.Background = [Windows.Media.BrushConverter]::new().ConvertFrom("#161B26") })

        $btn.Add_Click({
            $clickedBtn = $_.Source
            $tName      = ($clickedBtn.Content.Children[0].Children[0]).Text
            $tData      = $ToolData | Where-Object { $_.Name -eq $tName } | Select-Object -First 1
            if ($tData) { Invoke-ToolAction -tool $tData }
        })

        $searchStack.Children.Add($btn) | Out-Null
    }
})

# ==============================================================================
# EVENT WIRING
# ==============================================================================
$window.Add_MouseLeftButtonDown({ try { $window.DragMove() } catch {} })
$CloseBtn.Add_Click({ $window.Close() })
$MinBtn.Add_Click({ $window.WindowState = "Minimized" })

$OpenFolderBtn.Add_Click({
    if (-not (Test-Path $installDir)) { New-Item -ItemType Directory -Path $installDir -Force | Out-Null }
    Start-Process explorer.exe $installDir
    Write-Log "Opened install folder."
})

$ClearCacheBtn.Add_Click({
    if (Test-Path $installDir) {
        $items = Get-ChildItem -Path $installDir -Force -ErrorAction SilentlyContinue
        $count = @($items).Count
        $items | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue
        Write-Log "Cleared $count item(s) from install folder."
    } else {
        Write-Log "Nothing to clear - install folder does not exist yet."
    }
})

$OpenCmdBtn.Add_Click({
    Start-Process -FilePath "cmd.exe"
    Write-Log "Opened CMD."
})

Write-Log "Systeem geinitialiseerd."
Write-Log "Opslaglocatie: $installDir"
Write-Log "Wachten op input..."

$window.ShowDialog() | Out-Null
