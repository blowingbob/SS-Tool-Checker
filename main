[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

$installDir = "$env:USERPROFILE\Downloads\AntiSSTool"

# ==============================================================================
# TOOL DATA
# ==============================================================================
# We escapen de $ tekens met een backtick (`) zodat PowerShell ze niet 
# meteen uitvoert, maar als platte tekst doorgeeft aan het nieuwe venster.
$svchostScript = @"
# ================================================
# Şüpheli svchost Killer (Güvenli Versiyon)
# Github'dan direkt çalıştırılabilir
# ================================================

Write-Host "=== Şüpheli svchost Process Killer ===" -ForegroundColor Cyan
Write-Host "Normal svchost'lara dokunulmayacak.`n" -ForegroundColor Gray

`$svchosts = Get-Process -Name "svchost" -ErrorAction SilentlyContinue

if (`$svchosts.Count -eq 0) {
    Write-Host "Hiç svchost process'i bulunamadı!" -ForegroundColor Yellow
    Read-Host "Druk op Enter om te sluiten"
    exit
}

foreach (`$proc in `$svchosts) {
    try {
        `$cimProc = Get-CimInstance Win32_Process -Filter "ProcessId = `$(`$proc.Id)" -ErrorAction Stop
        `$parent = Get-Process -Id `$proc.ParentProcessId -ErrorAction SilentlyContinue
        
        `$commandLine = `$cimProc.CommandLine
        `$isSuspicious = `$false
        `$reason = ""

        # Kriterler
        if ([string]::IsNullOrWhiteSpace(`$commandLine) -or `$commandLine -notmatch "\-k ") {
            `$isSuspicious = `$true
            `$reason += " CommandLine yok veya -k parametresi eksik"
        }

        if (`$parent -and `$parent.Name -notin @("services.exe", "svchost.exe")) {
            `$isSuspicious = `$true
            `$reason += " Parent: `$(`$parent.Name)"
        }

        if (`$proc.StartTime -gt (Get-Date).AddHours(-1)) {
            `$isSuspicious = `$true
            `$reason += " Yeni başlatılmış"
        }

        if (`$isSuspicious) {
            Write-Host "[-] Şüpheli svchost tespit edildi! PID: `$(`$proc.Id) | `$( `$reason.Trim() )" -ForegroundColor Red
            Stop-Process -Id `$proc.Id -Force -ErrorAction SilentlyContinue
            Write-Host "    -> Öldürüldü" -ForegroundColor DarkRed
        }
        else {
            Write-Host "[+] Normal svchost -> PID: `$(`$proc.Id)" -ForegroundColor Green
        }
    }
    catch {
        Write-Host "[!] PID `$(`$proc.Id) incelenirken hata oluştu" -ForegroundColor Gray
    }
}

Write-Host "`nİşlem tamamlandı." -ForegroundColor Cyan
Write-Host "Script by Grok" -ForegroundColor DarkGray
Read-Host "`nDruk op Enter om te sluiten..."
"@

$ToolData = @(
    @{ 
        Name="Service"; 
        Desc="Şüpheli svchost Process Killer"; 
        Category="Services"; 
        Type="Cmd"; 
        RequireAdmin=$true; 
        Command=$svchostScript 
    }
)

$Categories = @(
    "Services"
)

