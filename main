# Fix voor de CMD one-liner: Forceer STA modus voor WPF
if ([System.Threading.Thread]::CurrentThread.ApartmentState -ne 'STA') {
    $scriptPath = $MyInvocation.MyCommand.Path
    if (-not $scriptPath) {
        Start-Process powershell -ArgumentList "-STA -NoProfile -ExecutionPolicy Bypass -Command `"iwr https://raw.githubusercontent.com/blowingbob/SS-Tool-Checker/main/main -UseBasicParsing | iex`""
        exit
    } else {
        Start-Process powershell -ArgumentList "-STA -NoProfile -ExecutionPolicy Bypass -File `"$scriptPath`""
        exit
    }
}

Add-Type -AssemblyName PresentationFramework
